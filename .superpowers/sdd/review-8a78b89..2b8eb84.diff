+    expect(res.status).toBe(404)
+    expect(await res.json()).toEqual({ error: 'Session not found' })
+    expect(mocks.invalidateSessionCache).not.toHaveBeenCalled()
+    expect(mocks.publishLogout).not.toHaveBeenCalled()
+  })
