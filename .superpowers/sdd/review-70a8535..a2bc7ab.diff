+    expect(providerIdToName('google.com')).toBe('google')
+    expect(providerIdToName('github.com')).toBe('github')
+    expect(providerIdToName('twitter.com')).toBe('x')
+    expect(providerIdToName('password')).toBe('password')
+  })
+
