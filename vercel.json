{
  "framework": "nextjs",
  "cleanUrls": true,
  "functions": {
    "src/app/api/v1/convert/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/v1/vectorize/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/v1/uploads/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
