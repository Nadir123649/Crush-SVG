{
  "framework": "nextjs",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path((?!_next|favicon.ico|robots.txt|sitemap.xml|manifest.webmanifest|sw.js|llms.*).*)",
      "has": [{ "type": "host", "value": "www.crushsvg.net" }],
      "destination": "https://crushsvg.net/:path",
      "permanent": true
    }
  ],
  "functions": {
    "src/app/api/v1/convert/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/v1/vectorize/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/v1/uploads/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
