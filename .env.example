# ============================================================
# HOW ENV FILES WORK HERE (Next.js NODE_ENV conditional):
#   .env               shared secrets — loaded in ALL environments
#   .env.development   local/staging overrides — loaded ONLY by `next dev`
#                      (NODE_ENV=development). "else" → .env.production
#   .env.production    production overrides — loaded ONLY by `next build`/`next start`
#                      (NODE_ENV=production)
# An env-specific file wins over .env for the same variable.
# Copy this file to .env (shared) + .env.development + .env.production
# and fill each with the values for that environment.
# On Vercel, repo env files are NOT read — set the same values in the
# dashboard (Development / Preview / Production) per environment.
# ============================================================

# Client — safe to expose (from Firebase console > Project settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Canonical app URL — used for CORS, email links, sitemap/robots, and SEO metadata.
# Goes in .env.development (http://localhost:3000) and .env.production
# (https://www.crushsvg.net). Staging (https://crush-svg.vercel.app) is set
# in the Vercel Preview env vars.
NEXT_PUBLIC_APP_URL=

# Security — trusted request origins for the auth middleware origin check and the
# response origin resolver. Comma-separated. Include every deployed environment.
# If unset, only NEXT_PUBLIC_APP_URL is trusted.
# Example: https://www.crushsvg.net,https://crush-svg.vercel.app
APP_ORIGINS=

# Trusted proxy — set to true ONLY when the app runs behind a reverse proxy that sets
# x-forwarded-for (e.g. Vercel, NGINX, Cloudflare). When false/unset, the client IP is
# taken only from request.ip / cf-connecting-ip / x-real-ip, never x-forwarded-for.
TRUST_PROXY=false

# Admin bootstrap — comma-separated emails to grant the 'admin' role at registration.
# Manually set the role in MongoDB for existing accounts, or re-trigger registration.
ADMIN_EMAILS=

# Sign-in methods: Email + password and Google OAuth only.
# In the Firebase console: Authentication > Settings > Authorized domains must
# include the EXACT production hostname, e.g. https://www.crushsvg.net (add both
# the bare domain and www if you serve both). Enable Google in Sign-in methods.
# No Firebase Admin SDK is used — the server verifies ID tokens via jose.

# Database — MongoDB connection string (Atlas or local)
MONGODB_URI=
MONGODB_DB_NAME=crushsvg
MONGODB_MAX_POOL_SIZE=10

# Node DNS override — comma-separated servers. Only needed when the machine's default
# DNS resolver is unreachable from Node (common on Windows). e.g. 8.8.8.8,8.8.4.4
DNS_SERVERS=

# JWT session tokens (server — generate strong random values, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Email (Resend preferred — verify a domain/sender in the Resend dashboard)
# Do NOT use the default "onboarding@resend.dev" shared domain in production:
# it is for testing only and delivery is slow/unreliable. Verify a custom domain
# (Resend dashboard > Domains > Add Domain, add the DNS records, wait for verification)
# and set RESEND_FROM, e.g. RESEND_FROM="CrushSVG <no-reply@yourdomain.com>"
RESEND_API_KEY=
RESEND_FROM=
# SMTP fallback (used when RESEND_API_KEY is unset). Example: Zoho Mail with a
# custom domain (smtp.zoho.com for the global data center, smtp.zoho.eu / .in / .com.cn
# for regional ones). Set up the domain in the Zoho Mail admin console (DNS MX, SPF,
# DKIM), create an app-specific password under Zoho account security (2FA required),
# and use the full mailbox address as SMTP_USER. Gmail SMTP cannot send from a
# custom domain — it always uses the Gmail address, so don't copy the local dev
# Gmail settings to production.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=no-reply@crushsvg.net
SMTP_PASS=
EMAIL_FROM="CrushSVG <no-reply@crushsvg.net>"

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (serverless-compatible rate limiting / session cache / queue backing).
# When both are set, rate limits, brute-force locks, and session cache move to Redis
# automatically; otherwise an in-memory store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Conversion queue (BullMQ). Set ENABLE_CONVERSION_QUEUE=true AND REDIS_URL to offload
# SVG→PNG conversion to a separate worker process (run `npm run worker`).
# Default (unset): conversions run inline in the web process.
ENABLE_CONVERSION_QUEUE=false
REDIS_URL=
