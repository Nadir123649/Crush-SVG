# Client — safe to expose (from Firebase console > Project settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=

# Server — Admin SDK service account (Firebase console > Project settings > Service accounts)
# FIREBASE_PRIVATE_KEY: paste with literal \n escapes, wrapped in quotes if it contains spaces
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Database — MongoDB connection string (Atlas or local)
MONGODB_URI=

# Node DNS override — comma-separated servers. Only needed when the machine's default
# DNS resolver is unreachable from Node (common on Windows). e.g. 8.8.8.8,8.8.4.4
DNS_SERVERS=

# JWT session tokens (server — generate strong random values, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Email (Resend preferred — verify a domain/sender in the Resend dashboard)
RESEND_API_KEY=
RESEND_FROM=
# SMTP fallback (used when RESEND_API_KEY is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# JWT session tokens (server — generate strong random values, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# App URL (for CORS and email links)
NEXT_PUBLIC_APP_URL=

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
