# Client — safe to expose (from Firebase console > Project settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=
# Canonical API URL — all client-side fetch calls target this origin.
# Empty in local dev (same-origin). Set to https://api.crushsvg.net (production)
# or https://staging.api.crushsvg.net (staging) in Vercel dashboard env vars.
NEXT_PUBLIC_API_URL=

# Security — trusted request origins for the auth middleware origin check and the
# response origin resolver. Comma-separated. If unset, only NEXT_PUBLIC_APP_URL is trusted.
APP_ORIGINS=

# Trusted proxy — set to true ONLY when the app runs behind a reverse proxy that sets
# x-forwarded-for (e.g. Vercel, NGINX, Cloudflare). When false/unset, the client IP is
# taken only from request.ip / cf-connecting-ip / x-real-ip, never x-forwarded-for.
TRUST_PROXY=false

# Admin bootstrap — comma-separated emails to grant the 'admin' role at registration,
# at login, and during OAuth. Also the configuration source for `npm run seed:admin`,
# which promotes existing accounts to role='admin' directly in MongoDB (idempotent).
# Leave blank unless you intend to grant admin access. Example: ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=

# Admin Seeding (Used for deployment script: npm run seed:admin)
ADMIN_PASSWORD=

# Server — Admin SDK service account (Firebase console > Project settings > Service accounts)
# FIREBASE_PRIVATE_KEY: paste with literal \n escapes, wrapped in quotes if it contains spaces
FIREBASE_PROJECT_ID= 
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Database — MongoDB connection string (Atlas or local)
MONGODB_URI=
MONGODB_DB_NAME=crushsvg
MONGODB_MAX_POOL_SIZE=10

# Node DNS override — comma-separated servers. Only needed when the machine's default
# DNS resolver is unreachable from Node (common on Windows). e.g. 8.8.8.8,8.8.4.4
DNS_SERVERS=

# JWT session tokens (server — generate strong random values, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Email (Resend preferred — verify a domain/sender in the Resend dashboard)
# Do NOT use the default "onboarding@resend.dev" shared domain in production:
# it is for testing only and delivery is slow/unreliable. Verify a custom domain
# (Resend dashboard > Domains > Add Domain, add the DNS records, wait for verification)
# and set RESEND_FROM, e.g. RESEND_FROM="CrushSVG <no-reply@yourdomain.com>"
RESEND_API_KEY=
RESEND_FROM=
# SMTP fallback (used when RESEND_API_KEY is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (serverless-compatible rate limiting / session cache / queue backing).
# When both are set, rate limits, brute-force locks, and session cache move to Redis
# automatically; otherwise an in-memory store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Conversion queue (BullMQ). Set ENABLE_CONVERSION_QUEUE=true AND REDIS_URL to offload
# SVG→PNG conversion to a separate worker process (run `npm run worker`).
# Default (unset): conversions run inline in the web process.
ENABLE_CONVERSION_QUEUE=false
REDIS_URL=

# Sentry error tracking (sentry.io — create a Next.js project and copy the DSN)
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser for client-side error reporting
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG and SENTRY_PROJECT are used at build time to upload source maps
SENTRY_ORG=
SENTRY_PROJECT=
# Optional: auth token for CI/CD source map uploads (Settings > Auth Tokens in Sentry)
SENTRY_AUTH_TOKEN=
