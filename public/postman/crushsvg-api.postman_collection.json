    {
      "name": "Validation & Usage",
      "description": "Validate SVG sources before converting and check remaining quota.",
      "item": [
        {
          "name": "Validate SVG",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/svg/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "svg", "validate"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"svg\": \"{{sampleSvg}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
