    {
      "name": "Conversion",
      "description": "Convert SVG to pixel-perfect PNG. Signed-in users are unlimited; guests get 3 conversions per 10 minutes (set-cookie gid). These requests run as guests by default — sign in first and switch the request auth to 'Inherit auth from parent' for user flows.",
      "item": [
        {
          "name": "Convert to PNG (JSON)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/convert",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "convert"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"svg\": \"{{sampleSvg}}\",\n  \"width\": 512,\n  \"transparent\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Converts an SVG string to PNG and returns it as base64 in `payload.data`. Max output 4000×4000 px.\n\nRate limit: 30 / min per IP. Guest budget: 3 / 10 min (429 `limit_reached`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Converts to PNG', () => {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.payload.format).to.eql('png');",
                  "  pm.expect(json.payload.data.length).to.be.above(0);",
                  "});",
                  "pm.test('Reports usage', () => {",
                  "  pm.expect(json.payload).to.have.property('conversionsUsed');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Convert to PNG (Download)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/convert?download=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "convert"],
              "query": [
                {
                  "key": "download",
                  "value": "1"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"svg\": \"{{sampleSvg}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same conversion, but returns the raw PNG binary with a Content-Disposition attachment header. Usage counters come back in X-Conversions-Used / X-Conversions-Remaining response headers.\n\nRate limit: 30 / min per IP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns a PNG binary', () => {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png');",
                  "  pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment');",
                  "});"
                ]
              }
            }
          ]
        },
